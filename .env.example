# GitHub Integration (optional - increases API rate limit)
GITHUB_TOKEN=your_github_personal_access_token_here

# WordPress.com OAuth application (migration only; never expose publicly)
WORDPRESS_CLIENT_ID=your_wordpress_client_id_here
WORDPRESS_CLIENT_SECRET=your_wordpress_client_secret_here

# Spotify OAuth application (local setup only; never expose publicly)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

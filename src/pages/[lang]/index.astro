---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../utils/lang';
import { languages } from '../../data/ui';
import { about } from '@/data/about';
import { Image } from 'astro:assets';
import MeImg from '../../assets/images/me.jpg';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const a = useTranslations(lang, about);
---

<Layout title={t('presentation.title')} description={t('presentation.description')} showNav={false}>
  <section class="landing-hero">
    <article class="hero-card">
      <div class="img-frame">
        <Image src={MeImg} alt={t('presentation.description')} class="me-img" />
      </div>
      <h1 class="hero-title">{t('presentation.title')}</h1>
      <p class="hero-bio">{t('presentation.description')}</p>
      
      <div class="hero-actions">
        <a href={`/${lang}/archive`} class="archive-btn">Explorar Arquivo ↗</a>
      </div>
    </article>
  </section>
</Layout>

<style>
  .landing-hero {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-height: 65vh;
  }
  .hero-card {
    max-width: 580px;
  }
  .img-frame {
    width: 180px;
    height: 180px;
    border: 1px solid #111111;
    margin-bottom: 1.5rem;
    overflow: hidden;
  }
  .me-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-title {
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .hero-bio {
    font-size: 0.95rem;
    line-height: 1.7;
    opacity: 0.9;
    margin-bottom: 2rem;
  }
  .archive-btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1px solid #111111;
    background-color: #111111;
    color: #F4F4F0;
    font-weight: 700;
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }
  .archive-btn:hover {
    background-color: transparent;
    color: #111111;
    text-decoration: none;
  }
</style>
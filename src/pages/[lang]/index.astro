---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../utils/lang';
import { languages } from '../../data/ui';
import presentation from '@/data/presentation';
import { Image } from 'astro:assets';
import MeImg from '../../assets/images/me.jpg';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const quickLinks = [
  { label: t('nav.archive'), href: `/${lang}/archive` },
  { label: t('nav.experience'), href: `/${lang}/experience` },
  { label: 'Email', href: `mailto:${presentation.mail}` },
];
---

<Layout title={t('presentation.title')} description={t('presentation.description')} showNav={false}>
  <section class="landing-hero grid lg:grid-cols-2 gap-12 items-center">
    <article class="hero-card">
      <div class="img-frame">
        <Image src={MeImg} alt={t('presentation.description')} class="me-img" />
      </div>
      <h1 class="hero-title">{t('presentation.title')}</h1>
      <p class="hero-bio">{t('presentation.description')}</p>

      <a href={`/${lang}/archive`} class="archive-link">{t('home.exploreArchive')} ↗</a>
    </article>

    <nav class="quick-links" aria-label="Quick links">
      {quickLinks.map((link) => (
        <a href={link.href} class="quick-link" target={link.href.startsWith('mailto:') ? undefined : '_self'}>
          {link.label}
        </a>
      ))}
    </nav>
  </section>
</Layout>

<style>
  .landing-hero {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-height: 65vh;
  }
  .hero-card {
    max-width: 580px;
  }
  .img-frame {
    width: 180px;
    height: 180px;
    margin-bottom: 2rem;
    overflow: hidden;
  }
  .me-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .hero-bio {
    font-size: 0.95rem;
    line-height: 1.7;
    opacity: 0.9;
    margin-bottom: 2rem;
  }
  .archive-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
  }
  .archive-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .quick-links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1rem;
    font-family: var(--font-mono);
  }
  .quick-link {
    font-size: 1rem;
    font-weight: 500;
  }
  .quick-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 1023px) {
    .quick-links {
      display: none;
    }
  }
</style>

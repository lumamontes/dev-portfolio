---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../utils/lang';
import { languages } from '../../data/ui';
import { about } from '@/data/about';
import presentation from '@/data/presentation';
import { Image } from 'astro:assets';
import MeImg from '../../assets/images/me.jpg';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const a = useTranslations(lang, about);

const socialLinks = presentation.socials;
---

<Layout title={t('presentation.title')} description={t('presentation.description')} showNav={false}>
  <section class="landing-hero grid lg:grid-cols-2 gap-12 items-center">
    <article class="hero-card">
      <div class="img-frame">
        <Image src={MeImg} alt={t('presentation.description')} class="me-img" />
      </div>
      <h1 class="hero-title">{t('presentation.title')}</h1>
      <p class="hero-bio">{t('presentation.description')}</p>

      <div class="hero-actions">
        <a href={`/${lang}/archive`} class="archive-btn">Explorar Arquivo ↗</a>
      </div>
    </article>
  </section>

  <section class="identity-section">
    <h2 class="section-label">// {t('about.title')}</h2>
    <p class="identity-bio">{t('about.description')}</p>

    <div class="skills-grid">
      <div>
        <p class="skills-heading">{a('skills.frontend')}</p>
        <ul class="skills-list">
          {about[lang]['frontend.skills'].map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
      <div>
        <p class="skills-heading">{a('skills.backend')}</p>
        <ul class="skills-list">
          {about[lang]['backend.skills'].map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
    </div>

    <a href={`/${lang}/experience`} class="inline-link">
      {lang === 'br' ? 'Ver histórico profissional completo →' : 'See full work history →'}
    </a>
  </section>

  <section class="contact-section">
    <h2 class="section-label">// {t('nav.contact')}</h2>
    <p class="identity-bio">{t('contact.description')}</p>

    <dl class="contact-grid">
      <div>
        <dt>{t('contact.location')}</dt>
        <dd>{t('contact.locationValue')}</dd>
      </div>
      <div>
        <dt>{t('contact.availability')}</dt>
        <dd>{t('contact.availabilityValue')}</dd>
      </div>
      <div>
        <dt>Email</dt>
        <dd><a href={`mailto:${presentation.mail}`}>{presentation.mail}</a></dd>
      </div>
    </dl>

    <ul class="contact-links">
      {socialLinks.filter((social) => social.label !== 'Email').map((social) => (
        <li><a href={social.link} target="_blank" rel="noopener noreferrer">{social.label}</a></li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .landing-hero {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-height: 65vh;
  }
  .hero-card {
    max-width: 580px;
  }
  .img-frame {
    width: 220px;
    height: 220px;
    border: 2px solid #111111;
    margin-bottom: 2rem;
    overflow: hidden;
    box-shadow: 6px 6px 0px #111111;
    transform: rotate(-1deg);
  }
  .me-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-title {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 0.9;
    margin-bottom: 1.5rem;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .hero-bio {
    font-size: 0.95rem;
    line-height: 1.7;
    opacity: 0.9;
    margin-bottom: 2rem;
  }
  .archive-btn {
    display: inline-block;
    padding: 1rem 1.5rem;
    border: 2px solid #111111;
    background-color: #111111;
    color: #F4F4F0;
    font-weight: 900;
    font-size: 1rem;
    text-transform: uppercase;
    box-shadow: 4px 4px 0px rgba(0,0,0,0.2);
    transition: all 0.1s steps(2);
  }
  .archive-btn:hover {
    background-color: transparent;
    color: #111111;
    text-decoration: none;
  }

  .identity-section,
  .contact-section {
    max-width: 640px;
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 2px solid #111111;
  }
  .section-label {
    font-family: 'Azeret Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.6;
    margin-bottom: 1rem;
  }
  .identity-bio {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-bottom: 1.5rem;
  }
  .skills-heading {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    opacity: 0.6;
  }
  .skills-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .skills-list li {
    font-size: 0.8rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid #111111;
  }
  .inline-link {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    font-family: 'Azeret Mono', monospace;
    font-size: 0.85rem;
  }
  .contact-grid dt {
    opacity: 0.55;
    text-transform: uppercase;
    font-size: 0.7rem;
    margin-bottom: 0.25rem;
  }
  .contact-grid dd {
    font-weight: 700;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    list-style: none;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.85rem;
  }
  .contact-links a:hover {
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { isPublicEntryInLanguage } from '@/lib/content-model';
import { getWordPressArchiveEntries, type WordPressArchiveEntry } from '@/lib/wordpress';
import { resolveEntryPreview } from '@/lib/portal-preview';

export async function getStaticPaths() {
  const [posts, booksEn, booksBr, learningNotes, zines, projects, photos, music] = await Promise.all([
    getCollection('posts'),
    getCollection('books-en'),
    getCollection('books-br'),
    getCollection('learning-notes'),
    getCollection('zines'),
    getCollection('projects'),
    getCollection('photos'),
    getCollection('music'),
  ]);

  // `project` now has its own canonical content collection (ticket 24) —
  // a WordPress-tagged `entry:project` post with the same slug would
  // otherwise silently win and shadow the real content below.
  const wordpressEntries = (await getWordPressArchiveEntries()).filter((entry) => entry.type !== 'project');
  const wordpressPaths = wordpressEntries.map((entry) => ({
    params: { lang: entry.lang, type: entry.type, slug: entry.slug.replace(/-en$/, '') },
    props: { wordpressEntry: entry },
  }));
  const wordpressKeys = new Set(wordpressPaths.map(({ params }) => `${params.lang}/${params.type}/${params.slug}`));
  const localPaths = [
    ...posts.filter((entry) => isPublicEntryInLanguage(entry, entry.data.lang)).map((entry) => ({ params: { lang: entry.data.lang, type: 'text', slug: entry.slug.split('/').slice(1).join('/') }, props: { entry } })),
    ...booksEn.filter((entry) => isPublicEntryInLanguage(entry, 'en')).map((entry) => ({ params: { lang: 'en', type: 'book', slug: entry.slug }, props: { entry } })),
    ...booksBr.filter((entry) => isPublicEntryInLanguage(entry, 'br')).map((entry) => ({ params: { lang: 'br', type: 'book', slug: entry.slug }, props: { entry } })),
    ...learningNotes.filter((entry) => isPublicEntryInLanguage(entry, entry.data.lang)).map((entry) => ({ params: { lang: entry.data.lang, type: 'learning-note', slug: entry.slug }, props: { entry } })),
    ...zines.filter((entry) => isPublicEntryInLanguage(entry, entry.data.lang)).map((entry) => ({ params: { lang: entry.data.lang, type: 'zine', slug: entry.slug }, props: { entry } })),
    ...projects.filter((entry) => isPublicEntryInLanguage(entry, entry.data.lang)).map((entry) => ({ params: { lang: entry.data.lang, type: 'project', slug: entry.slug }, props: { entry } })),
    ...photos.filter((entry) => isPublicEntryInLanguage(entry, entry.data.lang)).map((entry) => ({ params: { lang: entry.data.lang, type: 'photo', slug: entry.slug }, props: { entry } })),
    ...music.filter((entry) => isPublicEntryInLanguage(entry, entry.data.lang)).map((entry) => ({ params: { lang: entry.data.lang, type: 'music', slug: entry.slug }, props: { entry } })),
  ];
  return [...wordpressPaths, ...localPaths.filter(({ params }) => !wordpressKeys.has(`${params.lang}/${params.type}/${params.slug}`))];
}

const { entry, wordpressEntry } = Astro.props as { entry?: any; wordpressEntry?: WordPressArchiveEntry };
const isWordPressEntry = Boolean(wordpressEntry);
const type = wordpressEntry?.type ?? entry.data.type;
const lang = wordpressEntry?.lang ?? entry.data.lang;
const title = wordpressEntry?.title ?? entry.data.title;
const description = wordpressEntry?.description ?? (type === 'book' ? entry.data.author : entry.data.description);
const isBook = type === 'book';
const isZine = type === 'zine';
const isProject = type === 'project';
const isPhoto = type === 'photo';
const isMusic = type === 'music';
const Content = !isWordPressEntry ? (await entry.render()).Content : undefined;

const previewMode = isProject && !isWordPressEntry
  ? resolveEntryPreview({
      type: 'project',
      externalUrl: entry.data.externalUrl,
      embeddable: entry.data.embeddable,
    }).mode
  : undefined;
---

<Layout title={title} description={description}>
  <div class="flex flex-col lg:flex-row min-h-screen border-t-2 border-[#111111]">
    <article class="flex-1 py-12 px-6 lg:px-16 overflow-y-auto">
      <div class="max-w-3xl">
        <a href={`/${lang}/archive`} class="font-mono text-xs uppercase font-bold bg-[#111111] text-[#F4F4F0] px-2 py-1 inline-block mb-8">← INDEX</a>
        <header class="mb-12 border-b-4 border-[#111111] pb-8">
          <p class="font-mono text-xs uppercase tracking-widest mb-4 opacity-60">[{type}]</p>
          <h1 class="text-5xl md:text-8xl leading-[0.85] mb-6 break-words">{title}</h1>
          <p class="text-xl md:text-2xl font-medium leading-tight">{description}</p>
          <div class="mt-6 flex flex-wrap gap-4 font-mono text-[10px] uppercase">
            {isZine && !isWordPressEntry && <span class="bg-emerald-400 px-2 py-0.5 zine-border">BY {entry.data.authors.join(' & ')}</span>}
            {isPhoto && !isWordPressEntry && entry.data.place && <span class="bg-zinc-200 px-2 py-0.5 zine-border">LOC: {entry.data.place}</span>}
            {isMusic && !isWordPressEntry && <span class="bg-yellow-400 px-2 py-0.5 zine-border">SOURCE: {entry.data.kind}</span>}
            {isProject && !isWordPressEntry && entry.data.role && <span class="bg-zinc-200 px-2 py-0.5 zine-border">{entry.data.role}</span>}
            {isProject && !isWordPressEntry && entry.data.period && <span class="bg-zinc-200 px-2 py-0.5 zine-border">{entry.data.period}</span>}
          </div>
        </header>
        <div class="prose prose-zinc max-w-none prose-headings:uppercase prose-headings:font-black prose-img:zine-border prose-img:zine-shadow">
          {wordpressEntry ? <div set:html={wordpressEntry.html} /> : Content && <Content />}
        </div>

        {isPhoto && !isWordPressEntry && (
          <div class={`mt-10 grid gap-6 ${entry.data.images.length > 1 ? 'sm:grid-cols-2' : ''}`}>
            {entry.data.images.map((image: { src: string; alt: string; caption?: string; credit?: string; width?: number; height?: number }) => (
              <figure class="m-0">
                <a href={image.src} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size: ${image.alt}`}>
                  <img
                    src={image.src}
                    alt={image.alt}
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                    class="w-full border-2 border-[#111111] zine-shadow object-cover"
                  />
                </a>
                {(image.caption || image.credit) && (
                  <figcaption class="mt-2 font-mono text-xs opacity-60">
                    {image.caption}{image.caption && image.credit ? ' · ' : ''}{image.credit}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        )}

        {previewMode === 'live-embed' && (
          <div class="mt-10 border-2 border-[#111111] zine-shadow">
            <div class="flex items-center justify-between bg-[#111111] px-3 py-2 font-mono text-[10px] uppercase text-[#F4F4F0]">
              <span>Live preview</span>
              <a href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer" class="underline">
                Open in new tab ↗
              </a>
            </div>
            <iframe
              src={entry.data.externalUrl}
              title={`Live preview of ${title}`}
              loading="lazy"
              referrerpolicy="no-referrer"
              class="h-[600px] w-full border-0"
            />
          </div>
        )}

        {previewMode === 'link-card' && entry.data.externalUrl && (
          <a
            href={entry.data.externalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-10 flex items-center gap-4 border-2 border-[#111111] p-4 zine-shadow hover:bg-zinc-100"
          >
            {entry.data.cover ? (
              <img src={entry.data.cover} alt="" class="h-16 w-16 flex-shrink-0 object-cover" />
            ) : (
              <div class="flex h-16 w-16 flex-shrink-0 items-center justify-center border border-[#111111] bg-zinc-200 font-mono text-[10px] uppercase opacity-60">
                No preview
              </div>
            )}
            <span class="min-w-0">
              <span class="block font-mono text-[10px] uppercase opacity-60">Visit the real thing</span>
              <span class="block truncate font-bold">{title}</span>
              <span class="block truncate text-sm opacity-70">{description}</span>
            </span>
          </a>
        )}
      </div>
    </article>

    <aside class="w-full lg:w-[400px] border-t-2 lg:border-t-0 lg:border-l-2 border-[#111111] bg-zinc-100 p-8">
      <div class="sticky top-8">
        <h3 class="text-sm font-black mb-6 flex items-center gap-2">
          <span class="w-3 h-3 bg-red-500 rounded-full"></span> 
          DETALHES DO ARQUIVO
        </h3>
        
        <div class="space-y-8 font-mono text-[11px]">
          <div>
            <p class="opacity-50 mb-1">// RELAÇÃO</p>
            <p class="font-bold">ID: {wordpressEntry?.slug || entry?.slug || 'INTERNAL'}</p>
            <p class="font-bold">LANG: {lang.toUpperCase()}</p>
          </div>

          {isPhoto && !isWordPressEntry && (
            <div class="mt-10">
              <p class="opacity-50 mb-2">// IMAGES</p>
              <p class="font-bold">{entry.data.images.length} {entry.data.images.length === 1 ? 'photo' : 'photos'}</p>
            </div>
          )}
    {isZine && !isWordPressEntry && (
      <a href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer" class="mt-10 inline-flex rounded border border-emerald-400/50 px-4 py-3 font-mono text-sm text-emerald-300 hover:bg-emerald-400/10">
        Ler na Biblioteca de Zines ↗
      </a>
    )}
    {isMusic && !isWordPressEntry && (
      <a href={entry.data.sourceUrl} target="_blank" rel="noopener noreferrer" class="mt-10 inline-flex rounded border border-emerald-400/50 px-4 py-3 font-mono text-sm text-emerald-300 hover:bg-emerald-400/10">
        Ver publicação original ↗
      </a>
    )}
    {isProject && !isWordPressEntry && entry.data.stack.length > 0 && (
      <div class="mt-10">
        <p class="opacity-50 mb-2">// STACK</p>
        <ul class="flex flex-wrap gap-2">
          {entry.data.stack.map((tech: string) => (
            <li class="bg-zinc-200 px-2 py-0.5 zine-border">{tech}</li>
          ))}
        </ul>
      </div>
    )}
        </div>
      </div>
    </aside>
  </div>
</Layout>

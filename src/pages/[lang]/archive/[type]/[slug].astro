---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { isPublicEntryInLanguage } from '@/lib/content-model';
import type { WordPressArchiveEntry } from '@/lib/wordpress';
import { resolveEntryPreview } from '@/lib/portal-preview';
import { getArchiveEntries, getCanonicalWordPressEntries, groupArchiveEntries } from '@/lib/archive-entries';
import formatSeasonYear from '@/utils/formatSeasonYear';
import { useTranslations } from '@/utils/lang';

export async function getStaticPaths() {
  const [posts, booksEn, booksBr, learningNotes, zines, projects, photos, music, playlists] = await Promise.all([
    getCollection('posts'),
    getCollection('books-en'),
    getCollection('books-br'),
    getCollection('learning-notes'),
    getCollection('zines'),
    getCollection('projects'),
    getCollection('photos'),
    getCollection('music'),
    getCollection('playlists'),
  ]);

  // Shared with getArchiveEntries below (same underlying WordPress fetch,
  // memoized) — the project/book exclusion and playlist reclassification
  // live in exactly one place now, so path generation and the sidebar
  // can't disagree about which entries exist.
  const wordpressEntries = await getCanonicalWordPressEntries();
  // Computed once per language here (not per page) — every generated
  // page shares the same sidebar, and getArchiveEntries hits the
  // WordPress API, which would otherwise happen once per page instead
  // of once per language.
  const sidebarGroupsByLang = {
    en: groupArchiveEntries(await getArchiveEntries('en'), 'en'),
    br: groupArchiveEntries(await getArchiveEntries('br'), 'br'),
  } as const;

  const wordpressPaths = wordpressEntries.map((entry) => ({
    params: { lang: entry.lang, type: entry.type, slug: entry.slug.replace(/-en$/, '') },
    props: { wordpressEntry: entry, sidebarGroups: sidebarGroupsByLang[entry.lang] },
  }));
  const wordpressKeys = new Set(wordpressPaths.map(({ params }) => `${params.lang}/${params.type}/${params.slug}`));
  const localPaths = [
    ...posts.filter((entry) => isPublicEntryInLanguage(entry, entry.data.lang)).map((entry) => ({ params: { lang: entry.data.lang, type: 'text', slug: entry.slug.split('/').slice(1).join('/') }, props: { entry, sidebarGroups: sidebarGroupsByLang[entry.data.lang] } })),
    ...booksEn.filter((entry) => isPublicEntryInLanguage(entry, 'en')).map((entry) => ({ params: { lang: 'en', type: 'book', slug: entry.slug }, props: { entry, sidebarGroups: sidebarGroupsByLang.en } })),
    ...booksBr.filter((entry) => isPublicEntryInLanguage(entry, 'br')).map((entry) => ({ params: { lang: 'br', type: 'book', slug: entry.slug }, props: { entry, sidebarGroups: sidebarGroupsByLang.br } })),
    ...learningNotes.filter((entry) => isPublicEntryInLanguage(entry, entry.data.lang)).map((entry) => ({ params: { lang: entry.data.lang, type: 'learning-note', slug: entry.slug }, props: { entry, sidebarGroups: sidebarGroupsByLang[entry.data.lang] } })),
    ...zines.filter((entry) => isPublicEntryInLanguage(entry, entry.data.lang)).map((entry) => ({ params: { lang: entry.data.lang, type: 'zine', slug: entry.slug }, props: { entry, sidebarGroups: sidebarGroupsByLang[entry.data.lang] } })),
    ...projects.filter((entry) => isPublicEntryInLanguage(entry, entry.data.lang)).map((entry) => ({ params: { lang: entry.data.lang, type: 'project', slug: entry.slug }, props: { entry, sidebarGroups: sidebarGroupsByLang[entry.data.lang] } })),
    ...photos.filter((entry) => isPublicEntryInLanguage(entry, entry.data.lang)).map((entry) => ({ params: { lang: entry.data.lang, type: 'photo', slug: entry.slug }, props: { entry, sidebarGroups: sidebarGroupsByLang[entry.data.lang] } })),
    ...music.filter((entry) => isPublicEntryInLanguage(entry, entry.data.lang)).map((entry) => ({ params: { lang: entry.data.lang, type: 'music', slug: entry.slug }, props: { entry, sidebarGroups: sidebarGroupsByLang[entry.data.lang] } })),
    ...playlists.filter((entry) => isPublicEntryInLanguage(entry, entry.data.lang)).map((entry) => ({ params: { lang: entry.data.lang, type: 'playlist', slug: entry.slug }, props: { entry, sidebarGroups: sidebarGroupsByLang[entry.data.lang] } })),
  ];
  return [...wordpressPaths, ...localPaths.filter(({ params }) => !wordpressKeys.has(`${params.lang}/${params.type}/${params.slug}`))];
}

const { entry, wordpressEntry, sidebarGroups } = Astro.props as {
  entry?: any;
  wordpressEntry?: WordPressArchiveEntry;
  sidebarGroups: ReturnType<typeof groupArchiveEntries>;
};
const isWordPressEntry = Boolean(wordpressEntry);
const type = wordpressEntry?.type ?? entry.data.type;
const lang = wordpressEntry?.lang ?? entry.data.lang;
const t = useTranslations(lang);
const title = wordpressEntry?.title ?? entry.data.title;
const description = wordpressEntry?.description ?? entry.data.description;
const isBook = type === 'book';
const isText = type === 'text';
const isZine = type === 'zine';
const isProject = type === 'project';
const isPhoto = type === 'photo';
const isMusic = type === 'music';
const isPlaylist = type === 'playlist';
const Content = !isWordPressEntry && !isPlaylist && !isBook ? (await entry.render()).Content : undefined;
const playlistUrl = wordpressEntry?.externalUrl ?? entry?.data.externalUrl;
const playlistNote = !isWordPressEntry ? entry?.data.note : undefined;
const playlistCover = !isWordPressEntry ? entry?.data.cover : undefined;
const playlistPreview = isPlaylist ? resolveEntryPreview({ type: 'playlist', externalUrl: playlistUrl }) : undefined;
const spotifyEmbedUrl = playlistPreview?.mode === 'spotify-embed' ? playlistPreview.embedUrl : undefined;

const previewMode = isProject && !isWordPressEntry
  ? resolveEntryPreview({
      type: 'project',
      externalUrl: entry.data.externalUrl,
      embeddable: entry.data.embeddable,
    }).mode
  : undefined;

// Must match the slug shape getArchiveEntries/getStaticPaths use for this
// same entry, or the sidebar can never mark the current page as current:
// WordPress entries route with a trailing -en stripped, and text entries
// (nested under posts/<lang>/<slug>.md) use only the final path segment.
const currentSlug = wordpressEntry
  ? wordpressEntry.slug.replace(/-en$/, '')
  : type === 'text'
    ? entry.slug.split('/').pop()
    : entry.slug;
---

<Layout title={title} description={description}>
  <div class="flex flex-col lg:flex-row min-h-screen border-t-2 border-[#161513]">
    <aside class="w-full lg:w-[300px] lg:flex-shrink-0 border-b-2 lg:border-b-0 lg:border-l-2 border-[#161513] p-6 order-2">
      <div class="lg:sticky lg:top-6">
        <nav aria-label="Archive navigation">
          <h3 class="mb-4 text-xs font-black uppercase tracking-wide">{t('portal.navigate')}</h3>
          <div class="lg:max-h-[80vh] space-y-6 lg:overflow-y-auto lg:pr-2 font-mono text-[11px]">
            {sidebarGroups.map((group) => (
              <div>
                <p class="mb-2 border-b border-[#161513]/20 pb-1 text-[10px] font-bold uppercase tracking-wide opacity-70">{group.label}</p>
                <ul>
                  {group.entries.map((item) => {
                    const isCurrent = item.type === type && item.slug === currentSlug;
                    return (
                      <li class="relative block border-t border-dotted border-[#161513]/30 first:border-t-0">
                        {isCurrent && <span class="absolute -left-3 top-1.5 tracking-[-2px]" aria-hidden="true">—&gt;</span>}
                        <a
                          href={item.link}
                          target={item.link.startsWith('http') ? '_blank' : '_self'}
                          rel={item.link.startsWith('http') ? 'noopener noreferrer' : undefined}
                          aria-current={isCurrent ? 'page' : undefined}
                          class:list={[
                            'block truncate py-1.5 transition-[filter]',
                            isCurrent ? 'font-bold underline' : 'opacity-80 blur-none hover:opacity-100 hover:blur-[1px]',
                          ]}
                        >
                          {item.title}{item.link.startsWith('http') ? ' ↗' : ''}
                        </a>
                        {isCurrent && (
                          <div class="mb-3 pl-3 border-l-2 border-[#161513] text-[10px] normal-case opacity-80">
                            {description}
                          </div>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </div>
        </nav>
      </div>
    </aside>

    <article class="flex-1 min-w-0 overflow-y-auto order-1">
      <div class="border-b-2 border-[#161513] px-4 py-3 lg:px-10">
        <a href={`/${lang}/archive`} aria-label={t('portal.index')} class="inline-flex h-8 w-8 items-center justify-center hover:opacity-70">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
        </a>
      </div>

      {/* PREVIEW — the actual content is the point of clicking through, so it gets the dominant content column; the sidebar is a real but secondary lateral-nav aid. Sticky on desktop so it stays in view while the metadata below scrolls, matching the reference's fixed-position preview panel. */}
      <div class="px-4 py-8 lg:px-10 lg:sticky lg:top-0 lg:z-10 lg:bg-[#F2F1EA]">
        {isZine && !isWordPressEntry && entry.data.pdfUrl && (
          <div class="max-w-2xl border-2 border-[#161513] zine-shadow">
            <iframe
              src={entry.data.pdfUrl}
              title={`${title} — PDF`}
              loading="lazy"
              class="h-[70vh] w-full border-0"
            />
          </div>
        )}

        {isPlaylist && spotifyEmbedUrl && (
          <iframe
            src={spotifyEmbedUrl}
            title={`${title} — Spotify playlist`}
            loading="lazy"
            allow="encrypted-media"
            class="w-full max-w-lg border-0"
            style="height: 380px;"
          />
        )}
        {isPlaylist && !spotifyEmbedUrl && playlistUrl && (
          <a
            href={playlistUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 border-2 border-[#161513] p-4 zine-shadow hover:bg-zinc-100"
          >
            {playlistCover ? (
              <img src={playlistCover} alt="" class="h-16 w-16 flex-shrink-0 object-cover" />
            ) : (
              <div class="flex h-16 w-16 flex-shrink-0 items-center justify-center border border-[#161513] bg-zinc-200 font-mono text-[10px] uppercase opacity-60">
                {t('portal.noCover')}
              </div>
            )}
            <span class="min-w-0">
              <span class="block font-mono text-[10px] uppercase opacity-60">{t('portal.listenOnSpotify')}</span>
              <span class="block truncate font-bold">{title}</span>
            </span>
          </a>
        )}
        {isPlaylist && spotifyEmbedUrl && playlistUrl && (
          <a href={playlistUrl} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block font-mono text-xs uppercase underline opacity-70 hover:opacity-100">
            {t('portal.openInSpotify')} ↗
          </a>
        )}
        {isPlaylist && playlistNote && (
          <p class="mt-6 max-w-3xl text-lg opacity-80">{playlistNote}</p>
        )}

        {isPhoto && !isWordPressEntry && (
          <div class="max-w-3xl grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {entry.data.images.map((image: { src: string; alt: string; caption?: string; credit?: string; width?: number; height?: number }) => (
              <figure class="m-0">
                <a href={image.src} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size: ${image.alt}`}>
                  <img
                    src={image.src}
                    alt={image.alt}
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                    class="w-full border-2 border-[#161513] zine-shadow"
                  />
                </a>
                {(image.caption || image.credit) && (
                  <figcaption class="mt-2 font-mono text-xs opacity-60">
                    {image.caption}{image.caption && image.credit ? ' · ' : ''}{image.credit}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        )}

        {isBook && !isWordPressEntry && (
          <div class="max-w-3xl grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {entry.data.books.map((book: { title: string; author: string; cover?: string; externalUrl: string }) => (
              <a
                href={book.externalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex flex-col border-2 border-[#161513] zine-shadow hover:bg-zinc-100"
              >
                {book.cover ? (
                  <img src={book.cover} alt="" class="aspect-[2/3] w-full border-b-2 border-[#161513] object-cover" />
                ) : (
                  <div class="flex aspect-[2/3] w-full items-center justify-center border-b-2 border-[#161513] bg-zinc-200 font-mono text-[10px] uppercase opacity-60">
                    {t('portal.noCover')}
                  </div>
                )}
                <span class="p-3">
                  <span class="block font-bold">{book.title}</span>
                  <span class="block text-sm opacity-70">{book.author}</span>
                </span>
              </a>
            ))}
          </div>
        )}

        {previewMode === 'live-embed' && (
          <div class="border-2 border-[#161513] zine-shadow">
            <div class="flex items-center justify-between bg-[#161513] px-3 py-2 font-mono text-[10px] uppercase text-[#F2F1EA]">
              <span>{t('portal.livePreview')}</span>
              <a href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer" class="underline">
                {t('portal.openInNewTab')} ↗
              </a>
            </div>
            <iframe
              src={entry.data.externalUrl}
              title={`${t('portal.livePreview')}: ${title}`}
              loading="lazy"
              referrerpolicy="no-referrer"
              class="aspect-video w-full border-0"
            />
          </div>
        )}

        {previewMode === 'link-card' && entry.data.externalUrl && (
          <a
            href={entry.data.externalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 border-2 border-[#161513] p-4 zine-shadow hover:bg-zinc-100"
          >
            {entry.data.cover ? (
              <img src={entry.data.cover} alt="" class="h-16 w-16 flex-shrink-0 object-cover" />
            ) : (
              <div class="flex h-16 w-16 flex-shrink-0 items-center justify-center border border-[#161513] bg-zinc-200 font-mono text-[10px] uppercase opacity-60">
                {t('portal.noPreview')}
              </div>
            )}
            <span class="min-w-0">
              <span class="block font-mono text-[10px] uppercase opacity-60">{t('portal.visitTheRealThing')}</span>
              <span class="block truncate font-bold">{title}</span>
              <span class="block truncate text-sm opacity-70">{description}</span>
            </span>
          </a>
        )}

        {isText && !isWordPressEntry && entry.data.bannerImage && (
          <img
            src={entry.data.bannerImage}
            alt=""
            class="mb-8 max-w-3xl w-full border-2 border-[#161513] zine-shadow"
          />
        )}

        {!isPlaylist && !isBook && (
          <div class="prose prose-zinc max-w-3xl prose-headings:uppercase prose-headings:font-black prose-img:zine-border prose-img:zine-shadow">
            {wordpressEntry ? <div set:html={wordpressEntry.html} /> : Content && <Content />}
          </div>
        )}
      </div>

      {/* METADATA — comes after the preview/content, not before it */}
      <header class="max-w-3xl border-t-2 border-[#161513] px-4 py-8 lg:px-10">
        <h1 class="text-3xl md:text-5xl leading-[0.95] mb-4 break-words">{title}</h1>
        <p class="text-lg md:text-xl font-medium leading-tight">
          {description}
          {' '}
          {isText && !isWordPressEntry && entry.data.externalUrl && (
            <>{t('portal.originallyPublishedAt')}{' '}<a href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">{new URL(entry.data.externalUrl).hostname.replace(/^www\./, '')}</a>.</>
          )}
          {isZine && !isWordPressEntry && (
            <>{t('portal.readTheFullZineAt')}{' '}<a href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">Biblioteca de Zines</a>.</>
          )}
          {isMusic && !isWordPressEntry && (
            <>{t('portal.seeThe')}{' '}<a href={entry.data.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">{t('portal.originalPost')}</a>.</>
          )}
          {isProject && !isWordPressEntry && entry.data.repoUrl && (
            <>{' '}{t('portal.viewSourceOn')}{' '}<a href={entry.data.repoUrl} target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">GitHub</a>.</>
          )}
        </p>
        {(isText || isZine || isPhoto || isMusic || isProject) && !isWordPressEntry && (
          <div class="mt-4 flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase">
            <span class="opacity-50">{t('portal.filedUnder')}</span>
            {isText && entry.data.publishedAt && <span class="bg-zinc-200 px-2 py-0.5 zine-border">{formatSeasonYear(entry.data.publishedAt, lang)}</span>}
            {isZine && <span class="bg-emerald-400 px-2 py-0.5 zine-border">{t('portal.by')} {entry.data.authors.join(' & ')}</span>}
            {isPhoto && entry.data.place && <span class="bg-zinc-200 px-2 py-0.5 zine-border">{t('portal.location')} {entry.data.place}</span>}
            {isPhoto && <span class="bg-zinc-200 px-2 py-0.5 zine-border">{entry.data.images.length} {entry.data.images.length === 1 ? t('portal.photo') : t('portal.photos')}</span>}
            {isMusic && <span class="bg-zinc-200 px-2 py-0.5 zine-border">{t('portal.source')} {entry.data.kind}</span>}
            {isProject && entry.data.role && <span class="bg-zinc-200 px-2 py-0.5 zine-border">{entry.data.role}</span>}
            {isProject && entry.data.period && <span class="bg-zinc-200 px-2 py-0.5 zine-border">{entry.data.period}</span>}
          </div>
        )}
        {isProject && !isWordPressEntry && entry.data.stack.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2 font-mono text-[10px] uppercase">
            {entry.data.stack.map((tech: string) => (
              <li class="bg-zinc-200 px-2 py-0.5 zine-border">{tech}</li>
            ))}
          </ul>
        )}
      </header>
    </article>
  </div>
</Layout>

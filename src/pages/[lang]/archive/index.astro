---
import { languages } from '@/data/ui';
import Layout from '@/layouts/Layout.astro';
import { getLangFromUrl } from '@/utils/lang';
import { getArchiveEntries, groupArchiveEntries } from '@/lib/archive-entries';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const entries = await getArchiveEntries(lang);
const groups = groupArchiveEntries(entries);
---

<Layout title="Arquivo — Luma Goes" description="Arquivo de projetos, zines e textos." showNav={true}>
  <div class="archive-header">
    <h1 class="archive-title">ARQUIVO</h1>
    <span class="archive-count">INDEX / 2026</span>
  </div>

  <div class="archive-grid">
    {groups.map((group) => (
      <div class="archive-col">
        <h2 class="col-title">{group.label}</h2>
        <ul class="col-list">
          {group.entries.map((item) => (
            <li class="list-item">
              <a href={item.link} target={item.link.startsWith('http') ? '_blank' : '_self'} class="item-link">
                <span class="item-name">{item.title}{item.link.startsWith('http') ? ' ↗' : ''}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Layout>

<style>
  .archive-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 1rem;
    border-bottom: 1px solid #111111;
    margin-bottom: 2.5rem;
  }
  .archive-title {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .archive-count {
    font-size: 0.75rem;
    opacity: 0.6;
  }
  .archive-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    align-items: start;
    gap: 3rem;
  }
  @media (max-width: 1300px) {
    .archive-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 860px) {
    .archive-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  .col-title {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #111111;
    margin-bottom: 1rem;
  }
  .col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .list-item {
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .item-link {
    display: block;
  }
  .item-name {
    font-weight: 600;
  }
</style>

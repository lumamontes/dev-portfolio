---
import { languages } from '@/data/ui';
import Layout from '@/layouts/Layout.astro';
import { getLangFromUrl } from '@/utils/lang';


export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

import { getCollection } from 'astro:content';
import { getWordPressArchiveEntries } from '@/lib/wordpress';
import { isPublicEntryInLanguage } from '@/lib/content-model';

const lang = getLangFromUrl(Astro.url);

const [posts, booksEn, booksBr, learningNotes, zines, projectEntries, photos, musicCollection, wpEntries] = await Promise.all([
  getCollection('posts'),
  getCollection('books-en'),
  getCollection('books-br'),
  getCollection('learning-notes'),
  getCollection('zines'),
  getCollection('projects'),
  getCollection('photos'),
  getCollection('music'),
  getWordPressArchiveEntries(),
]);

// `project` and `book` have their own canonical local content
// collections — a WordPress-tagged post of either type would otherwise
// duplicate it under a different (and possibly stale) title, as already
// found for "Zine Library" / "Biblioteca de Zines" and confirmed here
// too for the Clean Code book entry.
const wpEntriesExcludingProjects = wpEntries.filter((e) => e.type !== 'project' && e.type !== 'book');

const localEntries = [
  ...posts.filter(e => isPublicEntryInLanguage(e, lang)).map(e => ({ title: e.data.title, type: 'text', slug: e.slug.split('/').pop(), lang, link: `/${lang}/archive/text/${e.slug.split('/').pop()}` })),
  ...(lang === 'en' ? booksEn : booksBr).filter(e => isPublicEntryInLanguage(e, lang)).map(e => ({ title: e.data.title, type: 'book', slug: e.slug, lang, link: `/${lang}/archive/book/${e.slug}` })),
  ...learningNotes.filter(e => isPublicEntryInLanguage(e, lang)).map(e => ({ title: e.data.title, type: 'learning-note', slug: e.slug, lang, link: `/${lang}/archive/learning-note/${e.slug}` })),
  ...zines.filter(e => isPublicEntryInLanguage(e, lang)).map(e => ({ title: e.data.title, type: 'zine', slug: e.slug, lang, link: e.data.externalUrl || `/${lang}/archive/zine/${e.slug}` })),
  // Always link to the entry's own portal page, never straight out to
  // externalUrl — that's where the live-embed/link-card tiers (ticket 29)
  // actually render; bypassing it here would skip the portal entirely.
  ...projectEntries.filter(e => isPublicEntryInLanguage(e, lang)).map(e => ({ title: e.data.title, type: 'project', slug: e.slug, lang, link: `/${lang}/archive/project/${e.slug}` })),
  ...photos.filter(e => isPublicEntryInLanguage(e, lang)).map(e => ({ title: e.data.title, type: 'photo', slug: e.slug, lang, link: `/${lang}/archive/photo/${e.slug}` })),
  ...musicCollection.filter(e => isPublicEntryInLanguage(e, lang)).map(e => ({ title: e.data.title, type: 'music', slug: e.slug, lang, link: `/${lang}/archive/music/${e.slug}` })),
];

const allEntries = [
  ...localEntries, 
  ...wpEntriesExcludingProjects.filter(e => e.lang === lang).map(e => ({ ...e, link: e.externalUrl || `/${lang}/archive/${e.type}/${e.slug}` }))
];

const writings = allEntries.filter(e => ['text', 'learning-note'].includes(e.type));
const projects = allEntries.filter(e => ['project', 'zine'].includes(e.type));
const music = allEntries.filter(e => e.type === 'music');
const books = allEntries.filter(e => e.type === 'book');
const photosGroup = allEntries.filter(e => e.type === 'photo');
---

<Layout title="Arquivo — Luma Goes" description="Arquivo de projetos, zines e textos." showNav={true}>
  <div class="archive-header">
    <h1 class="archive-title">ARQUIVO</h1>
    <span class="archive-count">INDEX / 2026</span>
  </div>

  <div class="archive-grid">
    <!-- Column 1: Writing -->
    <div class="archive-col">
      <h2 class="col-title">Escritos & Textos</h2>
      <ul class="col-list">
        {writings.map((item) => (
          <li class="list-item">
            <a href={`/${lang}/archive/${item.type}/${item.slug}`} class="item-link">
              <span class="item-name">{item.title}</span>
              <span class="item-meta">[{item.type}]</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 2: Projects & Zines -->
    <div class="archive-col">
      <h2 class="col-title">Projetos & Labs</h2>
      <ul class="col-list">
        {projects.map((item) => (
          <li class="list-item">
            <a href={item.link} target={item.link?.startsWith('http') ? "_blank" : "_self"} class="item-link">
              <span class="item-name">{item.title} {item.link?.startsWith('http') ? '↗' : ''}</span>
              <span class="item-meta">{item.type}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 3: Music & Media -->
    <div class="archive-col">
      <h2 class="col-title">Música & Mídia</h2>
      <ul class="col-list">
        {music.map((item) => (
          <li class="list-item">
            <div class="item-link">
              <span class="item-name">{item.title}</span>
              <span class="item-meta">{item.type}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 4: Books -->
    {books.length > 0 && (
      <div class="archive-col">
        <h2 class="col-title">Livros</h2>
        <ul class="col-list">
          {books.map((item) => (
            <li class="list-item">
              <a href={item.link} class="item-link">
                <span class="item-name">{item.title}</span>
                <span class="item-meta">{item.type}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Column 5: Photos -->
    {photosGroup.length > 0 && (
      <div class="archive-col">
        <h2 class="col-title">Fotos</h2>
        <ul class="col-list">
          {photosGroup.map((item) => (
            <li class="list-item">
              <a href={item.link} class="item-link">
                <span class="item-name">{item.title}</span>
                <span class="item-meta">{item.type}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</Layout>

<style>
  .archive-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 1rem;
    border-bottom: 1px solid #111111;
    margin-bottom: 2.5rem;
  }
  .archive-title {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .archive-count {
    font-size: 0.75rem;
    opacity: 0.6;
  }
  .archive-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: start;
    gap: 3rem;
  }
  @media (max-width: 1100px) {
    .archive-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 860px) {
    .archive-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  .col-title {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #111111;
    margin-bottom: 1rem;
  }
  .col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .list-item {
    font-size: 0.85rem;
  }
  .item-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .item-name {
    font-weight: 600;
  }
  .item-meta {
    font-size: 0.725rem;
    opacity: 0.55;
  }
</style>

---
import { languages } from '@/data/ui';
import Layout from '@/layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '@/utils/lang';
import { getArchiveEntries, groupArchiveEntries } from '@/lib/archive-entries';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const entries = await getArchiveEntries(lang);
const groups = groupArchiveEntries(entries, lang);
---

<Layout title={t('archive.pageTitle')} description={t('archive.description')} showNav={true}>
  <div class="archive-header">
    <h1 class="archive-title">{t('nav.archive')}</h1>
  </div>

  <div class="archive-grid">
    {groups.map((group) => (
      <div class="archive-col">
        <h2 class="col-title">{group.label}</h2>
        <ul class="col-list">
          {group.entries.map((item) => (
            <li class="list-item">
              <a href={item.link} target={item.link.startsWith('http') ? '_blank' : '_self'} class="item-link">
                <span class="item-name">{item.title}{item.link.startsWith('http') ? ' ↗' : ''}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Layout>

<style>
  .archive-header {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-ink);
    margin-bottom: 2.5rem;
  }
  .archive-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .archive-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: start;
    gap: 3rem 2.5rem;
  }
  @media (max-width: 1100px) {
    .archive-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .archive-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  .col-title {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-ink);
    margin-bottom: 1rem;
  }
  .col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .list-item {
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .item-link {
    display: block;
  }
  .item-name {
    font-weight: 600;
  }
</style>

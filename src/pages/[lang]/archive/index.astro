---
import { languages } from '@/data/ui';
import Layout from '@/layouts/Layout.astro';
import { getLangFromUrl } from '@/utils/lang';


export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

import { getCollection } from 'astro:content';
import { getWordPressArchiveEntries } from '@/lib/wordpress';
import { isPublicEntryInLanguage } from '@/lib/content-model';

const lang = getLangFromUrl(Astro.url);

const [posts, booksEn, booksBr, learningNotes, zines, photos, musicCollection, wpEntries] = await Promise.all([
  getCollection('posts'),
  getCollection('books-en'),
  getCollection('books-br'),
  getCollection('learning-notes'),
  getCollection('zines'),
  getCollection('photos'),
  getCollection('music'),
  getWordPressArchiveEntries(),
]);

const localEntries = [
  ...posts.filter(e => isPublicEntryInLanguage(e, lang)).map(e => ({ title: e.data.title, type: 'text', slug: e.slug.split('/').pop(), lang })),
  ...(lang === 'en' ? booksEn : booksBr).filter(e => isPublicEntryInLanguage(e, lang)).map(e => ({ title: e.data.title, type: 'book', slug: e.slug, lang })),
  ...learningNotes.filter(e => isPublicEntryInLanguage(e, lang)).map(e => ({ title: e.data.title, type: 'learning-note', slug: e.slug, lang })),
  ...zines.filter(e => isPublicEntryInLanguage(e, lang)).map(e => ({ title: e.data.title, type: 'zine', slug: e.slug, lang })),
  ...photos.filter(e => isPublicEntryInLanguage(e, lang)).map(e => ({ title: e.data.title, type: 'photo', slug: e.slug, lang })),
  ...musicCollection.filter(e => isPublicEntryInLanguage(e, lang)).map(e => ({ title: e.data.title, type: 'music', slug: e.slug, lang })),
];

const allEntries = [...localEntries, ...wpEntries.filter(e => e.lang === lang)];

const writings = allEntries.filter(e => ['text', 'learning-note'].includes(e.type));
const projects = allEntries.filter(e => ['project', 'zine'].includes(e.type));
const music = allEntries.filter(e => e.type === 'music');
---

<Layout title="Arquivo — Luma Goes" description="Arquivo de projetos, zines e textos." showNav={true}>
  <div class="archive-header">
    <h1 class="archive-title">ARQUIVO</h1>
    <span class="archive-count">INDEX / 2026</span>
  </div>

  <div class="archive-grid">
    <!-- Column 1: Writing -->
    <div class="archive-col">
      <h2 class="col-title">Escritos & Textos</h2>
      <ul class="col-list">
        {writings.map((item) => (
          <li class="list-item">
            <a href={`/${lang}/archive/${item.type}/${item.slug}`} class="item-link">
              <span class="item-name">{item.title}</span>
              <span class="item-meta">[{item.type}]</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 2: Projects & Zines -->
    <div class="archive-col">
      <h2 class="col-title">Projetos & Labs</h2>
      <ul class="col-list">
        {projects.map((item) => (
          <li class="list-item">
            <a href={item.link} target={item.link.startsWith('http') ? "_blank" : "_self"} class="item-link">
              <span class="item-name">{item.title} ↗</span>
              <span class="item-meta">{item.type}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 3: Music & Media -->
    <div class="archive-col">
      <h2 class="col-title">Música & Mídia</h2>
      <ul class="col-list">
        {music.map((item) => (
          <li class="list-item">
            <div class="item-link">
              <span class="item-name">{item.title}</span>
              <span class="item-meta">{item.type}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Layout>

<style>
  .archive-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 1rem;
    border-bottom: 1px solid #111111;
    margin-bottom: 2.5rem;
  }
  .archive-title {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .archive-count {
    font-size: 0.75rem;
    opacity: 0.6;
  }
  .archive-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
  }
  @media (max-width: 860px) {
    .archive-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  .col-title {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #111111;
    margin-bottom: 1rem;
  }
  .col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .list-item {
    font-size: 0.85rem;
  }
  .item-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .item-name {
    font-weight: 600;
  }
  .item-meta {
    font-size: 0.725rem;
    opacity: 0.55;
  }
</style>

---
import { ui } from "@/data/ui";
import { getLangFromUrl } from "@/utils/lang";
import CdGif from "@/assets/cd.gif";
import { Image } from "astro:assets";

const lang = getLangFromUrl(Astro.url);
---

<section class="listening-widget" aria-live="polite">
  <!-- CD Container -->
  <div class="cd-frame">
    <Image 
      data-cd-image
      src={CdGif} 
      alt="Spinning CD" 
      class="cd-gif is-idle"
    />
    <!-- Center Hub Album Art -->
    <div class="album-hub">
      <img 
        data-album-cover 
        src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E" 
        alt="" 
        class="album-cover is-hidden" 
      />
    </div>
  </div>

  <!-- Track Info Ticker -->
  <div class="track-container">
    <div class="status-header">
      <span data-status-dot class="status-dot"></span>
      <span>{ui[lang]["currently.listening"]}</span>
    </div>

    <div class="marquee-viewport">
      <div data-listening class="marquee-content">
        <span class="fallback-text">{ui[lang]["currently.listening.description"]}</span>
      </div>
    </div>
  </div>
</section>

<script>
  const listening = document.querySelector<HTMLElement>('[data-listening]');
  const cdImage = document.querySelector<HTMLElement>('[data-cd-image]');
  const albumCover = document.querySelector<HTMLImageElement>('[data-album-cover]');
  const statusDot = document.querySelector<HTMLElement>('[data-status-dot]');

  if (listening) {
    fetch('/api/listening')
      .then((res) => {
        if (res.status === 204 || !res.ok) return null;
        return res.json();
      })
      .then((track) => {
        // IDLE STATE (No music playing)
        if (!track || !track.title) {
          if (cdImage) {
            cdImage.classList.add('is-idle');
            cdImage.classList.remove('is-playing');
          }
          if (statusDot) statusDot.classList.remove('is-active');
          if (albumCover) albumCover.classList.add('is-hidden');
          
          listening.innerHTML = `<span class="idle-text">Not listening right now</span>`;
          return;
        }

        // PLAYING STATE
        if (cdImage) {
          cdImage.classList.remove('is-idle');
          cdImage.classList.add('is-playing');
        }
        if (statusDot) statusDot.classList.add('is-active');

        // Album Art Hub
        if (albumCover && track.albumImageUrl) {
          albumCover.src = track.albumImageUrl;
          albumCover.alt = track.album || track.title;
          albumCover.classList.remove('is-hidden');
        }

        const trackText = `${track.title} — ${track.artist}`;
        const content = `${trackText} \u00A0\u00A0\u2022\u00A0\u00A0 ${trackText} \u00A0\u00A0\u2022\u00A0\u00A0 `;

        if (track.url) {
          listening.innerHTML = `
            <a href="${track.url}" target="_blank" rel="noopener noreferrer" class="marquee-track marquee-scroll">
              ${content}
            </a>
          `;
        } else {
          listening.innerHTML = `
            <span class="marquee-track marquee-scroll">
              ${content}
            </span>
          `;
        }
      })
      .catch(() => {
        if (cdImage) {
          cdImage.classList.add('is-idle');
          cdImage.classList.remove('is-playing');
        }
        if (listening) listening.innerHTML = `<span class="idle-text">Offline</span>`;
      });
  }
</script>

<style>
  .listening-widget {
    position: fixed;
    top: 6.5rem;
    right: 1.5rem;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    background-color: #F4F4F0;
    border: 1px solid #111111;
    font-family: 'Azeret Mono', monospace;
    font-size: 0.75rem;
    box-shadow: 2px 2px 0px #111111;
  }

  .cd-frame {
    position: relative;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid #111111;
    background-color: #e5e5e0;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cd-gif {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease, filter 0.3s ease;
  }

  /* Spin animation control */
  .cd-gif.is-idle {
    opacity: 0.35;
    filter: grayscale(100%);
    animation: spin 12s linear infinite;
    animation-play-state: paused; /* Freezes rotation when not playing */
  }

  .cd-gif.is-playing {
    opacity: 1;
    filter: grayscale(0%);
    animation: spin 4s linear infinite;
    animation-play-state: running;
  }

  .album-hub {
    position: absolute;
    width: 38%;
    height: 38%;
    border-radius: 50%;
    border: 1px solid #111111;
    overflow: hidden;
    z-index: 10;
    pointer-events: none;
    background-color: #111111;
  }

  .album-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .album-cover.is-hidden {
    opacity: 0;
  }

  .track-container {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    width: 11rem;
  }

  .status-header {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.625rem;
    text-transform: uppercase;
    opacity: 0.6;
    letter-spacing: 0.05em;
  }

  .status-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background-color: #9ca3af;
  }

  .status-dot.is-active {
    background-color: #10b981;
    animation: pulse 2s infinite;
  }

  .marquee-viewport {
    position: relative;
    overflow: hidden;
    white-space: nowrap;
    margin-top: 0.125rem;
    width: 100%;
  }

  .marquee-content {
    display: inline-block;
  }

  .marquee-track {
    display: inline-block;
    white-space: nowrap;
    font-weight: 800;
    font-style: italic;
    color: #111111;
    background-image: url('/purple.jpg');
    background-size: cover;
    background-position: center;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .marquee-scroll {
    animation: marquee-slide 10s linear infinite;
  }

  .idle-text, .fallback-text {
    opacity: 0.5;
    font-style: normal;
    font-weight: normal;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes marquee-slide {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
</style>
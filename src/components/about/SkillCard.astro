---
interface Props {
  title: string;
  skills: string[];
}

const { title, skills } = Astro.props;
---

<div class="group bg-zinc-900/30 rounded-xl border border-zinc-800/50 p-6 backdrop-blur-sm hover:border-white/30 transition-all duration-300">
  <div class="flex items-center gap-3 mb-4">
    <h3 class="text-xl font-semibold text-white">{title}</h3>
  </div>
  <div class="space-y-3">
    {skills.map((skill) => (
      <div class="flex items-center justify-between group/skill">
        <span class="text-zinc-300 group-hover/skill:text-white transition-colors">{skill}</span>
      </div>
    ))}
  </div>
</div> 
---
import Link from "./shared/Link.astro";
import presentation from "@/data/presentation";
---
<ul role="list">
  {
    presentation.socials.map((social, index) => (
        <li>
          <Link href={social.link} label={social.label} />
        </li>
    ))
  }
</ul>

<style is:global>
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    display: inline;
  }
  a {
    text-decoration: none;
    color: inherit;
  }
  a:hover {
    text-decoration: underline;
  }
</style>
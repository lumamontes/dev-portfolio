---
import SocialLinks from '@/components/SocialLinks.astro';
import Header from '../components/Header.astro';
import '../styles/post.css';
import '../styles/tailwind.css';

interface Props {
  title: string;
  description: string;
  showNav?: boolean;
}

const { title, description, showNav = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@100..900&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  </head>
  <body class="site-shell">
    <Header showNav={showNav} />
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <SocialLinks />
    </footer>
  </body>
</html>

<style is:global>
  :root {
    /* Off-white photocopy paper and near-black ink — shifted off the
       generic-cream/flat-black defaults, still reads as "off-white." */
    --color-paper: #F2F1EA;
    --color-ink: #161513;
    /* The one riso spot color — used sparingly and deliberately, never
       as a general-purpose accent for every badge/highlight. */
    --color-riso-pink: #FF3684;
    --font-display: 'Big Shoulders Display', sans-serif;
    --font-body: 'IBM Plex Sans', sans-serif;
    --font-mono: 'IBM Plex Mono', monospace;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    border: 0;
  }
  html, body {
    background-color: var(--color-paper);
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ink);
    min-height: 100vh;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .site-shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .site-main {
    flex: 1;
    margin-top: 2rem;
  }
  .site-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-ink);
    display: flex;
    gap: 1.5rem;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
</style>